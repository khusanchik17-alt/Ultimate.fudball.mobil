# Build outputs. `build/` is scratch space; `artifacts/` is where the CI
# workflow publishes the signed APK so it can be downloaded from the repo.
/build/
/out/
*.ap_
*.aab
*.dex
*.class
# generated outputs (npm run build / tools/build_apk.sh create them)
/web/game.bundle.js
/android/app/src/main/assets/www/
/.tools/
# note: artifacts/*.apk IS tracked on purpose - it is the download of the game

/toolchain/node_modules/
node_modules/
/android/gen/
/android/obj/
/android/bin/
.gradle/
local.properties
*.iml
.idea/
.DS_Store

__pycache__/
*.pyc
