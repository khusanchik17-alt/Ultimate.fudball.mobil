{
  "name": "ultimate-football-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Ultimate Football Mobile - original 3D football game for Android (WebGL engine + native Android shell)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node tools/build_web.mjs",
    "build:watch": "node tools/build_web.mjs --watch",
    "serve": "node tools/serve.mjs",
    "test": "node tests/run-tests.mjs",
    "test:dom": "node tools/smoke-dom.mjs",
    "test:android": "python3 tools/check_android_api.py",
    "sim": "node tools/sim-report.mjs",
    "icons": "python3 tools/make_icons.py",
    "apk": "npm run build && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "esbuild": "0.20.2",
    "eslint": "^8.57.1",
    "jsdom": "^24.1.3",
    "three": "0.160.1"
  }
}
