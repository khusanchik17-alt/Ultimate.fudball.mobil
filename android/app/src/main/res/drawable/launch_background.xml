<?xml version="1.0" encoding="utf-8"?>
<!-- Native window background shown for the few milliseconds before the WebView
     paints the game's own animated splash screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ufm_navy" />
    <item>
        <bitmap
            android:src="@drawable/splash_logo"
            android:gravity="center" />
    </item>
</layer-list>
